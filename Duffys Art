  .hero h1 em { display: block; color: var(--red); font-weight: 500; }
  .hero p { max-width: 34em; color: var(--ink-soft); margin: 22px 0 32px; font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; }
  .stamp {
    position: relative; width: min(250px, 100%); aspect-ratio: 1; margin-inline: auto;
    border: 3px solid var(--red); border-radius: 50%; color: var(--red);
    display: grid; place-items: center; text-align: center; transform: rotate(-8deg);
  }
  .stamp::before { content: ''; position: absolute; inset: 10px; border: 1.5px dashed var(--red); border-radius: 50%; }
  .stamp span { font-size: .72rem; font-weight: 600; letter-spacing: .25em; text-transform: uppercase; }
  .stamp strong { display: block; font-family: 'Fraunces', serif; font-weight: 900; font-size: 2.1rem; line-height: 1; margin: 6px 0; color: var(--ink); }

  /* Sections */
  section { padding: 80px 0; }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px 24px; padding-bottom: 16px; margin-bottom: 32px; border-bottom: 2px solid var(--ink); }
  .section-head h2 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .section-head p { color: var(--ink-soft); }
  .section-head a { color: var(--red); font-weight: 600; }

  /* Gallery: one big feature piece, the rest smaller */
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .gallery figure {
    aspect-ratio: 1; background: var(--paper-2); border: 2px solid var(--ink);
    display: grid; place-items: center; color: var(--ink-soft); font-size: .9rem; overflow: hidden;
  }
  .gallery figure:first-child { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; }

  /* Booking steps */
  #how { background: var(--paper-2); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .steps { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 56px; counter-reset: s; }
  .steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 18px; padding: 24px 0; border-top: 1px solid rgba(28,23,20,.25); }
  .steps li::before { counter-increment: s; content: counter(s); font-family: 'Fraunces', serif; font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--red); }
  .steps h3 { font-size: 1.35rem; margin-bottom: 4px; }
  .steps p { color: var(--ink-soft); }

  /* Contact */
  #contact { background: var(--ink); color: var(--paper); }
  #contact h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  #contact h2 em { color: var(--mustard); font-weight: 500; }
  #contact p { color: #cfc5b6; margin: 14px 0 30px; max-width: 32em; }
  #contact .btn { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  #contact .btn-line { background: transparent; color: var(--paper); border-color: var(--paper); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 16px; }

  /* Garage cross-link */
  .cross-link { background: var(--sage); color: var(--paper); padding: 26px 0; }
  .cross-link .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .cross-link a { font-weight: 600; color: var(--paper); text-underline-offset: 4px; }

  footer { padding: 26px 0; font-size: .9rem; color: var(--ink-soft); }
  footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .stamp { width: 180px; margin: 8px 0 0; }
    .stamp strong { font-size: 1.6rem; }
    .steps { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: repeat(2, 1fr); }
    .gallery figure:first-child { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 4 / 3; }
    .menu-toggle { display: block; }
    .nav ul { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: var(--paper); border-bottom: 2px solid var(--ink); }
    .nav ul.open { display: flex; }
    .nav ul a { display: block; padding: 14px 16px; border-top: 1px solid rgba(28,23,20,.2); border-bottom: 0; }
    section { padding: 60px 0; }
  }
</style>
</head>
