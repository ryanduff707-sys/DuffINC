  img { max-width: 100%; display: block; }
  .wrap { width: min(1080px, 100% - 32px); margin-inline: auto; }

  /* Buttons: hard offset shadow instead of soft glow */
  .btn {
    display: inline-block; font-weight: 600; text-decoration: none;
    padding: 12px 22px; border: 2px solid var(--ink);
    background: var(--ink); color: var(--paper);
    box-shadow: 4px 4px 0 var(--red);
    transition: transform .15s, box-shadow .15s;
  }
  .btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--red); }
  .btn-line { background: transparent; color: var(--ink); box-shadow: 4px 4px 0 var(--mustard); }
  .btn-line:hover { box-shadow: 6px 6px 0 var(--mustard); }

  /* Header */
  header { border-bottom: 2px solid var(--ink); background: var(--paper); position: relative; z-index: 10; }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; }
  .logo { font-family: 'Fraunces', serif; font-weight: 900; font-size: 1.5rem; text-decoration: none; letter-spacing: -.01em; line-height: 1.1; }
  .logo small { display: block; font-family: 'Work Sans', sans-serif; font-weight: 600; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--red); }
  .nav ul { list-style: none; display: flex; align-items: center; gap: 26px; }
  .nav ul a { text-decoration: none; font-weight: 500; border-bottom: 2px solid transparent; padding-bottom: 2px; }
  .nav ul a:hover { border-color: var(--red); }
  .menu-toggle { display: none; background: none; border: 2px solid var(--ink); color: var(--ink); font-size: 1.3rem; width: 44px; height: 40px; cursor: pointer; }

  /* Hero */
  .hero { padding: 72px 0 64px; border-bottom: 2px solid var(--ink); }
  .hero-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: 48px; align-items: center; }
