<style>
  /* Palette pulled from old-school flash sheets: cream paper, black ink, red, mustard, sage */
  :root {
    --paper: #f3ecdf;
    --paper-2: #e9dfcc;
    --ink: #1c1714;
    --ink-soft: #5b5048;
    --red: #a3271b;
