    <button class="menu-toggle" aria-label="Open menu" onclick="document.getElementById('menu').classList.toggle('open')">☰</button>
    <ul id="menu">
      <li><a href="#tuning">Tuning & About</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#addons">Add-ons</a></li>
      <li><a href="#how">How It Works</a></li>
