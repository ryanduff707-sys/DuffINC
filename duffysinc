<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dufys Garage | Mobile Auto Repair & Tuning</title>
<meta name="description" content="Dufys Garage — on-call mobile auto repair and tuning specializing in German automotives. COBB and ECS Tuning experience. We come to you.">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0f1113;
    --bg-alt: #16191c;
    --card: #1c2024;
    --line: #2a2f35;
    --text: #e9ecef;
    --muted: #9aa3ad;
    --accent: #e10600;
    --accent-2: #ffb400;
    --radius: 10px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }
  h1, h2, h3 { font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .03em; line-height: 1.15; }
  a { color: inherit; text-decoration: none; }
  .wrap { width: min(1100px, 100% - 32px); margin-inline: auto; }

  /* ---------- Header ---------- */
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(15,17,19,.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .logo { font-family: 'Oswald', sans-serif; font-size: 1.5rem; font-weight: 700; text-transform: uppercase; }
  .logo span { color: var(--accent); }
  .nav ul { list-style: none; display: flex; gap: 28px; }
  .nav ul a { color: var(--muted); font-weight: 500; font-size: .95rem; transition: color .2s; }
  .nav ul a:hover { color: var(--text); }
  .btn {
    display: inline-block; background: var(--accent); color: #fff;
    padding: 12px 22px; border-radius: 6px; font-weight: 600;
    transition: transform .15s, background .2s;
  }
  .btn:hover { background: #ff1a14; transform: translateY(-1px); }
  .btn-ghost { background: transparent; border: 1px solid var(--line); }
  .btn-ghost:hover { background: var(--card); }
  .menu-toggle { display: none; background: none; border: 0; color: var(--text); font-size: 1.6rem; cursor: pointer; }

  /* ---------- Hero ---------- */
  .hero {
    padding: 90px 0 70px;
    background:
      linear-gradient(115deg, rgba(225,6,0,.18) 0%, transparent 45%),
      repeating-linear-gradient(135deg, transparent 0 22px, rgba(255,255,255,.015) 22px 44px),
      var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .stripe { display: flex; gap: 4px; margin-bottom: 22px; }
  .stripe i { width: 34px; height: 5px; display: block; }
  .stripe i:nth-child(1){ background: #1c69d4; }
  .stripe i:nth-child(2){ background: #0a2a6b; }
  .stripe i:nth-child(3){ background: var(--accent); }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero p { color: var(--muted); font-size: 1.15rem; max-width: 560px; margin: 18px 0 30px; }
  .hero .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--line);
    padding: 6px 14px; border-radius: 999px; font-size: .85rem; color: var(--accent-2);
    margin-bottom: 18px;
  }
  .badge::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-2); }

  /* ---------- Sections ---------- */
  section { padding: 80px 0; }
  .eyebrow { color: var(--accent); font-weight: 600; font-size: .85rem; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 8px; }
  .section-title { font-size: clamp(1.9rem, 4vw, 2.7rem); margin-bottom: 14px; }
  .section-lead { color: var(--muted); max-width: 620px; margin-bottom: 44px; }

  /* ---------- About / Tuning ---------- */
  #tuning { background: var(--bg-alt); border-bottom: 1px solid var(--line); }
  .about-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: start; }
  .about-grid p { color: var(--muted); margin-bottom: 16px; }
  .about-grid p strong { color: var(--text); }
  .feature-list { display: grid; gap: 14px; }
  .feature {
    background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 18px 20px;
  }
  .feature h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .feature p { color: var(--muted); font-size: .95rem; margin: 0; }

  /* ---------- Pricing ---------- */
  .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; }
  .price-card {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 28px 24px; display: flex; flex-direction: column;
    transition: border-color .2s, transform .2s;
  }
  .price-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .price-card.popular { border-color: var(--accent); position: relative; }
  .price-card.popular::after {
    content: 'Most Complete'; position: absolute; top: -11px; left: 24px;
    background: var(--accent); color: #fff; font-size: .72rem; font-weight: 600;
    padding: 3px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: .05em;
  }
  .price-card h3 { font-size: 1.25rem; margin-bottom: 10px; }
  .price { font-family: 'Oswald', sans-serif; font-size: 2.6rem; font-weight: 700; margin-bottom: 14px; }
  .price sup { font-size: 1.2rem; vertical-align: super; color: var(--muted); }
  .price-card ul { list-style: none; color: var(--muted); font-size: .93rem; display: grid; gap: 6px; margin-bottom: 24px; flex: 1; }
  .price-card li::before { content: '✓ '; color: var(--accent); font-weight: 700; }
  .price-card .btn { text-align: center; }

  /* ---------- Add-ons ---------- */
  #addons { background: var(--bg-alt); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .addon-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .addon {
    background: var(--card); border: 1px dashed var(--line); border-radius: var(--radius);
    padding: 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .addon span { font-weight: 500; }
  .tag { font-size: .75rem; color: var(--accent-2); border: 1px solid rgba(255,180,0,.35); padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
  .note { color: var(--muted); font-size: .9rem; margin-top: 22px; }

  /* ---------- How it works ---------- */
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; counter-reset: step; }
  .step { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .step::before {
    counter-increment: step; content: '0' counter(step);
    font-family: 'Oswald', sans-serif; font-size: 2rem; color: var(--accent); display: block; margin-bottom: 6px;
  }
  .step h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .step p { color: var(--muted); font-size: .95rem; }

  /* ---------- Contact ---------- */
  #contact { text-align: center; background: linear-gradient(180deg, var(--bg) 0%, rgba(225,6,0,.12) 100%); }
  #contact .section-lead { margin-inline: auto; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  footer { border-top: 1px solid var(--line); padding: 28px 0; color: var(--muted); font-size: .9rem; }
  footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }

  /* ---------- Mobile ---------- */
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .menu-toggle { display: block; }
    .nav ul {
      display: none; position: absolute; top: 64px; left: 0; right: 0;
      flex-direction: column; gap: 0; background: var(--bg-alt); border-bottom: 1px solid var(--line);
    }
    .nav ul.open { display: flex; }
    .nav ul a { display: block; padding: 14px 16px; border-top: 1px solid var(--line); }
    .nav .btn.desktop { display: none; }
    section { padding: 60px 0; }
  }
</style>
</head>
<body>

